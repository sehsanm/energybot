# Prod Dockerfile: skips the Node admin-build stage and installs deps from
# pre-downloaded wheels in .deploy/wheels/ (so the prod build never has to
# reach pypi.org or a third-party Iran mirror, which are unreliable / paywalled).
#
# bin/deploy.sh refreshes .deploy/wheels/ and admin_ui/out/ on each deploy.
FROM python:3.12-slim
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s|http://deb.debian.org|http://$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; fi \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends libmagic1 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONUNBUFFERED=1
COPY .deploy/wheels /wheels
COPY pyproject.toml ./
COPY alembic.ini ./
COPY alembic ./alembic
COPY src ./src
RUN pip install --no-cache-dir --no-index --find-links=/wheels -e .
COPY admin_ui/out ./admin_ui/out
COPY .deploy/tiktoken-cache /tmp/data-gym-cache
ENV ENERGYBOT_ADMIN_STATIC_DIR=/app/admin_ui/out
ENV MEDIA_ROOT=/var/lib/energybot/media
RUN mkdir -p $MEDIA_ROOT
EXPOSE 8000
CMD ["uvicorn", "energybot.main:app", "--host", "0.0.0.0", "--port", "8000"]

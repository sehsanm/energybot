# --- App ---
# Public base URL of this deployment (used for bot login links & mini-app buttons)
PUBLIC_BASE_URL=https://energy.example.ir
DATABASE_PATH=./data/energybot.db
# >=32 random chars; signs sessions/CSRF
SESSION_SECRET=change-me-to-a-long-random-string

# --- Channels ---
BALE_ENABLED=true
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Iran network: all Telegram API traffic goes through this HTTP(S) proxy (e.g. arvan-zar)
TELEGRAM_PROXY_URL=
TELEGRAM_POLL_TIMEOUT=30
BALE_POLL_TIMEOUT=30

# --- Finnotech (bill inquiry only) ---
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_NATIONAL_ID=
FINNOTECH_BASE_URL=https://apiv2.finnotech.ir
FINNOTECH_TOKEN_PATH=/dev/v2/oauth2/token
FINNOTECH_INQUIRY_PATH=/oak/v2/clients/{client_id}/utility/detailBillingInquiry

# --- AI (any OpenAI-compatible endpoint) ---
AI_BASE_URL=https://api.metisai.ir/openai/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional fallback used when the primary fails
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# --- Admin ---
# First admin bootstrapped on startup if no admin exists: admin@local / password
ADMIN_BOOTSTRAP_EMAIL=admin@energybot.local
ADMIN_BOOTSTRAP_PASSWORD=change-me
